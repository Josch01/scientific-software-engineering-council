{
  "schema_version": 1,
  "model_type": "sir",
  "equation_set": "sir_frequency_dependent_v1",
  "equations": {
    "dS/dt": "-beta(t) * S * I / N",
    "dI/dt": "beta(t) * S * I / N - gamma(t) * I",
    "dR/dt": "gamma(t) * I"
  },
  "states": ["S", "I", "R"],
  "initial_conditions": {
    "S": 990.0,
    "I": 10.0,
    "R": 0.0
  },
  "parameters": {
    "beta": {
      "kind": "piecewise_linear",
      "points": [[0.0, 0.3], [5.0, 0.25], [10.0, 0.2]]
    },
    "gamma": {
      "kind": "constant",
      "value": 0.1
    }
  },
  "t_span": [0.0, 10.0],
  "units": {
    "time": "day",
    "population": "person",
    "rate": "1/day"
  },
  "integrator": {
    "method": "RK4_FIXED_STEP",
    "max_step": 0.1,
    "max_steps": 100
  }
}
